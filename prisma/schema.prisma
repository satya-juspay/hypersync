generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ReleasePR {
  id               String    @id
  title            String
  author           String
  authorEmail      String?
  displayName      String
  sourceBranch     String?
  releaseBranch    String
  mainPrId         String?
  patchFingerprint String?
  updatedStatus    String?
  updatedBy        String?
  updatedAt        DateTime?
  mergedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([sourceBranch])
}

model MainPR {
  id               String    @id
  title            String
  author           String
  displayName      String
  sourceBranch     String?
  status           String
  patchFingerprint String?
  mergedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([sourceBranch])
}

model SyncStatus {
  id         String    @id @default("singleton")
  isRunning  Boolean   @default(false)
  lastSynced DateTime?
  runId      String?
  runStartedAt DateTime?
  leaseUntil DateTime?
}

model AdminUser {
  email     String   @id
  createdAt DateTime @default(now())
  createdBy String?
}
