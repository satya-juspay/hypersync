generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ReleasePR {
  id                    String    @id
  title                 String
  author                String
  authorEmail           String?
  displayName           String
  sourceBranch          String?
  releaseBranch         String
  mainPrId              String?
  patchFingerprint      String?
  patchFingerprintError String?
  updatedStatus         String?
  updatedBy             String?
  updatedAt             DateTime?
  mergedAt              DateTime?
  createdAt             DateTime  @default(now())

  @@index([sourceBranch])
}

model MainPR {
  id                    String    @id
  title                 String
  author                String
  displayName           String
  sourceBranch          String?
  status                String
  patchFingerprint      String?
  patchFingerprintError String?
  mergedAt              DateTime?
  createdAt             DateTime  @default(now())

  @@index([sourceBranch])
}

model SyncStatus {
  id           String    @id @default("singleton")
  isRunning    Boolean   @default(false)
  lastSynced   DateTime?
  runId        String?
  runStartedAt DateTime?
  leaseUntil   DateTime?
}

model AdminUser {
  email     String   @id
  createdAt DateTime @default(now())
  createdBy String?
}

// Isolated UI Components dataset. Existing hyper-widget models above are not
// reused. Only snapshots belonging to syncStatus.activeRunId are published.
model UiComponentRefreshRun {
  id               String                       @id
  status           String                       @default("RUNNING")
  startedAt        DateTime                     @default(now())
  finishedAt       DateTime?
  error            String?
  branchManifest   String[]                     @default([])
  branchCount      Int                          @default(0)
  commitCount      Int                          @default(0)
  analysisVersion  Int                          @default(0)
  mainPrManifest   Int[]                        @default([])
  analysisManifest String[]                     @default([])
  mainPrCount      Int                          @default(0)
  mainPrs          UiComponentMainPr[]
  analyses         UiComponentCommitAnalysis[]
  snapshots        UiComponentReleaseSnapshot[]
  activeFor        UiComponentSyncStatus?       @relation("UiComponentActiveRun")

  @@index([status, startedAt])
}

model UiComponentSyncStatus {
  id          String                 @id @default("singleton")
  runId       String?
  leaseUntil  DateTime?
  lastSynced  DateTime?
  activeRunId String?                @unique
  activeRun   UiComponentRefreshRun? @relation("UiComponentActiveRun", fields: [activeRunId], references: [id], onDelete: Restrict)
}

model UiComponentReleaseSnapshot {
  id                   String                      @id
  runId                String
  branch               String
  widgetHeadSha        String
  uiComponentsRef      String
  uiComponentsRefType  String
  uiComponentsHeadSha  String
  uiComponentsBranches String[]                    @default([])
  jenkinsBoundarySha   String?
  status               String
  warnings             String[]                    @default([])
  expectedCommitCount  Int
  sealed               Boolean                     @default(false)
  createdAt            DateTime                    @default(now())
  run                  UiComponentRefreshRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  commits              UiComponentSnapshotCommit[]

  @@unique([runId, branch])
  @@index([branch, createdAt])
  @@index([uiComponentsHeadSha])
}

model UiComponentReleaseCommit {
  sha             String                      @id
  displayId       String
  authorName      String?
  authorEmail     String?
  authorTimestamp DateTime?
  message         String
  parents         String[]                    @default([])
  createdAt       DateTime                    @default(now())
  snapshots       UiComponentSnapshotCommit[]
  analyses        UiComponentCommitAnalysis[]
}

model UiComponentSnapshotCommit {
  snapshotId String
  commitSha  String
  snapshot   UiComponentReleaseSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  commit     UiComponentReleaseCommit   @relation(fields: [commitSha], references: [sha], onDelete: Restrict)

  @@id([snapshotId, commitSha])
  @@index([commitSha])
}

model UiComponentMainPr {
  runId             String
  prId              Int
  title             String
  state             String
  authorName        String
  fromBranch        String
  toBranch          String
  sourceSha         String
  targetSha         String
  updatedAt         DateTime
  commitShas        String[]              @default([])
  patchFingerprint  String?
  fingerprintStatus String
  fingerprintError  String?
  run               UiComponentRefreshRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([runId, prId])
}

model UiComponentCommitAnalysis {
  runId             String
  commitSha         String
  patchFingerprint  String?
  fingerprintStatus String
  fingerprintError  String?
  run               UiComponentRefreshRun    @relation(fields: [runId], references: [id], onDelete: Restrict)
  commit            UiComponentReleaseCommit @relation(fields: [commitSha], references: [sha], onDelete: Restrict)

  @@id([runId, commitSha])
  @@index([commitSha])
}

// A failed diff remains skipped across runs, even if its refresh later aborts.
model UiComponentDiffFailure {
  key       String   @id
  createdAt DateTime @default(now())
}
